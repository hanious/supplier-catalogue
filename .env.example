# Keep this file aligned with application configuration and docker-compose.yml.
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://dynamodb:8000
TABLE_NAME=supplier-catalogue-local
SUPPLIER_URL=http://supplier:8081
HTTP_ADDR=:8080
ALLOWED_ORIGIN=http://localhost:55801
# Local fast pacing; use these settings to slow a recovery demonstration.
RECORD_INTERVAL_MS=0
RECORDS_PER_SLICE=0
# Lease fencing remains active across process restarts.
LEASE_SECONDS=20
WORK_SLICE_SECONDS=10
# Native integration tests only; Compose supplies its service URL automatically.
INTEGRATION_DYNAMODB_ENDPOINT=
